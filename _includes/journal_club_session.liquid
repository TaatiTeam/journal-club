{% comment %}
  Session from _data/journal_club.yml. Upcoming sessions inherit meeting
  logistics; archive entries show only their own recorded time and place.
{% endcomment %}
{% assign s = include.session %}
{% assign s_date = s.date | default: '' %}
{% assign s_time = s.time | default: '' %}
{% assign s_speaker_url = s.speaker_url | default: '' %}
{% assign s_affiliation = s.affiliation | default: '' %}
{% assign s_title = s.title | default: '' %}
{% assign s_paper = s.paper | default: '' %}
{% assign s_abstract = s.abstract | default: '' %}
{% assign s_location = s.location | default: '' %}
{% if include.mode == 'upcoming' %}
  {% assign s_time = s.time | default: site.data.journal_club.meeting.time | default: '' %}
  {% assign s_location = s.location | default: site.data.journal_club.meeting.location | default: '' %}
{% endif %}
<article class="jc-session{% if include.mode == 'upcoming' %} jc-session-upcoming{% else %} jc-session-past{% endif %}">
  <div class="jc-date">
    {% if s_date != '' %}
      <time datetime="{{ s.date | date: '%Y-%m-%d' }}">
        {% if include.mode == 'upcoming' %}
          <span class="jc-date-month">{{ s.date | date: '%b' }}</span>
          <span class="jc-date-day">{{ s.date | date: '%d' }}</span>
          <span class="jc-date-year">{{ s.date | date: '%Y' }}</span>
        {% else %}
          {{ s.date | date: '%b %-d' }}
        {% endif %}
      </time>
    {% else %}
      <span class="jc-date-tbd">Date to be announced</span>
    {% endif %}
    {% if s_time != '' -%}
      <span class="jc-time">{{ s_time | escape }}</span>
    {%- endif %}
  </div>
  <div class="jc-session-body">
    {% if include.mode == 'upcoming' %}
      <p class="jc-session-label">
        {% if include.first -%}
          <span class="session-dot" aria-hidden="true"></span>Next session
        {%- else -%}
          Coming up
        {%- endif -%}
        {%- if s_date != '' -%}
          <span class="jc-session-weekday"> / {{ s.date | date: '%A' }}</span>
        {%- endif %}
      </p>
    {% endif %}
    <h3 class="jc-session-title">
      {% if s_title != '' %}
        {% if s_paper != '' -%}
          <a href="{{ s_paper | escape }}">{{ s_title | escape }}</a>
        {%- else -%}
          {{- s_title | escape -}}
        {%- endif %}
      {% else %}
        {% if s_speaker_url != '' -%}
          <a href="{{ s_speaker_url | escape }}">{{ s.speaker | escape }}</a>
        {%- else -%}
          {{- s.speaker | escape -}}
        {%- endif %}
      {% endif %}
    </h3>
    {% if s_title != '' or s_affiliation != '' %}
      <p class="jc-speaker">
        {% if s_title != '' %}
          {% if s_speaker_url != '' -%}
            <a href="{{ s_speaker_url | escape }}">{{ s.speaker | escape }}</a>
          {%- else -%}
            {{- s.speaker | escape -}}
          {%- endif %}
        {% endif %}
        {% if s_affiliation != '' -%}
          <span class="jc-affil">
            {%- if s_title != '' %} · {% endif -%}
            {{- s_affiliation | escape -}}
          </span>
        {%- endif %}
      </p>
    {% endif %}
    {% if s_abstract != '' %}
      <div class="jc-abstract">{{ s_abstract | markdownify }}</div>
    {% endif %}
    {% if s_location != '' or s_paper != '' %}
      <div class="jc-session-footer">
        {% if s_location != '' %}
          <p class="jc-where">{{ s_location | escape }}</p>
        {% endif %}
        {% if s_paper != '' -%}
          <a
            class="jc-paper-link"
            href="{{ s_paper | escape }}"
            aria-label="Read paper: {{ s_title | default: s.speaker | escape }}"
            >Read paper <span aria-hidden="true">↗</span></a
          >
        {%- endif %}
      </div>
    {% endif %}
  </div>
</article>
