{% comment %}
  Renders one journal club session from _data/journal_club.yml.
  Usage: {% include journal_club_session.liquid session=s %}
{% endcomment %}
{% assign s = include.session %}
<div class="jc-session">
  <div class="jc-date">
    {% if s.date %}{{ s.date | date: '%b %-d, %Y' }}{% else %}Date TBD{% endif %}
    {% if s.time != blank %}
      <div class="jc-time">{{ s.time }}</div>
    {% endif %}
  </div>
  <div class="jc-body">
    <div class="jc-speaker">
      {% if s.speaker_url != blank -%}
        <a href="{{ s.speaker_url }}">{{ s.speaker }}</a>
      {%- else -%}
        {{- s.speaker -}}
      {%- endif %}
      {% if s.affiliation != blank -%}
        <span class="jc-affil">, {{ s.affiliation }}</span>
      {%- endif %}
    </div>
    {% if s.title != blank %}
      <div class="jc-title">
        {% if s.paper != blank -%}
          <a href="{{ s.paper }}">{{ s.title }}</a>
        {%- else -%}
          {{- s.title -}}
        {%- endif %}
      </div>
    {% endif %}
    {% if s.abstract != blank %}
      <div class="jc-abstract">{{ s.abstract | markdownify }}</div>
    {% endif %}
    {% if s.location != blank %}
      <div class="jc-where"><i class="fa-solid fa-location-dot"></i>{{ s.location }}</div>
    {% endif %}
    {% if s.paper != blank %}
      <div class="jc-links"><a href="{{ s.paper }}">Paper</a></div>
    {% endif %}
  </div>
</div>
